#!name=MEEFF 去广告（进阶版）
#!desc=基础+进阶合并版：① 拦截 MEEFF 集成的第三方广告 SDK 域名；② 拦截 MEEFF 自有 API 的广告类接口；③ 可选启用 JSON 广告过滤脚本。第①②层已开启，需配合 Shadowrocket 的 HTTPS 解密使用。
#!author=Codex
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png

[Rule]
# ============================================================
# 第一层：广告 SDK 域名拦截
# 依据：MEEFF Android 6.x 静态分析（Exodus Privacy）确认的广告 SDK
# ============================================================

# Google AdMob / DoubleClick
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,2mdn.net,REJECT
DOMAIN,adservice.google.com,REJECT

# Meta Audience Network（只拦 an.facebook.com，不影响 Facebook 登录/分享）
DOMAIN,an.facebook.com,REJECT

# AppLovin MAX（MEEFF 的主要广告聚合平台）
DOMAIN-SUFFIX,applovin.com,REJECT
DOMAIN-SUFFIX,applvn.com,REJECT

# ironSource
DOMAIN-SUFFIX,ironsrc.com,REJECT
DOMAIN-SUFFIX,ironsrc.mobi,REJECT
DOMAIN-SUFFIX,ironsrc.media,REJECT
DOMAIN-SUFFIX,supersonicads.com,REJECT
DOMAIN-SUFFIX,ssacdn.com,REJECT

# Pangle（TikTok/字节跳动广告）
DOMAIN-SUFFIX,pangleglobal.com,REJECT
DOMAIN-SUFFIX,pangle-ssr.com,REJECT

# Tapjoy
DOMAIN-SUFFIX,tapjoy.com,REJECT
DOMAIN-SUFFIX,tapjoyads.com,REJECT
DOMAIN-SUFFIX,tapjoy.net,REJECT

# Unity Ads（只拦广告相关主机）
DOMAIN-SUFFIX,unityads.unity3d.com,REJECT
DOMAIN,adserver.unity3d.com,REJECT
DOMAIN,prd-adserver.unity3d.com,REJECT
DOMAIN,prd-vod.unity3d.com,REJECT
DOMAIN,prd-adplayer.unity3d.com,REJECT

# Amazon Ads
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT
DOMAIN-SUFFIX,aaxads.com,REJECT

# AD(X)
DOMAIN-SUFFIX,adx.com,REJECT
DOMAIN-SUFFIX,adxplatform.com,REJECT

# AdFit（Daum/Kakao，韩国广告网络）
DOMAIN-SUFFIX,adfit.co.kr,REJECT

# AdPie（GOM Factory，韩国广告网络）
DOMAIN-SUFFIX,adpie.io,REJECT
DOMAIN-SUFFIX,adpie.co.kr,REJECT

# TNK Factory（韩国广告网络）
DOMAIN-SUFFIX,tnkfactory.com,REJECT
DOMAIN-SUFFIX,tnkfactory.co.kr,REJECT

# Fyber / Inneractive
DOMAIN-SUFFIX,fyber.com,REJECT
DOMAIN-SUFFIX,fybercdn.com,REJECT
DOMAIN-SUFFIX,inner-active.mobi,REJECT

# Mintegral
DOMAIN-SUFFIX,mintegral.com,REJECT
DOMAIN-SUFFIX,mintegral.net,REJECT

# 归因/追踪（可去掉行首 # 开启）
# DOMAIN-SUFFIX,adjust.com,REJECT

# 可选扩展：其他常见移动广告网络（去掉行首 # 启用）
# DOMAIN-SUFFIX,vungle.com,REJECT
# DOMAIN-SUFFIX,vungle.tv,REJECT
# DOMAIN-SUFFIX,adcolony.com,REJECT
# DOMAIN-SUFFIX,adcolony.net,REJECT
# DOMAIN-SUFFIX,inmobi.com,REJECT
# DOMAIN-SUFFIX,chartboost.com,REJECT
# DOMAIN-SUFFIX,chartboost.net,REJECT
# DOMAIN-SUFFIX,smaato.net,REJECT
# DOMAIN-SUFFIX,pubnative.net,REJECT
# DOMAIN-SUFFIX,ogury.co,REJECT
# DOMAIN-SUFFIX,startappservice.com,REJECT
# DOMAIN-SUFFIX,bidmachine.io,REJECT
# DOMAIN-SUFFIX,moloco.com,REJECT
# DOMAIN-SUFFIX,unrulymedia.com,REJECT
# DOMAIN-SUFFIX,appnext.com,REJECT

# ============================================================
# 第二层：MEEFF 自有 API 广告接口拦截（已开启）
# 依赖 HTTPS 解密：需先安装并信任 CA 证书
# ============================================================
[URL Rewrite]
^https?:\/\/api\.meeff\.com\/(?:[^\/]+\/)?(?:ad|ads|advert|advertisements?|banner|banners|interstitial|splash|sponsor|sponsored|promotion|promoted|nativead|nativeads|native_ad|native_ads|adunit|ad_unit)(?:[\/\?]|$) reject

# ============================================================
# 第三层（可选）：JSON 广告过滤脚本
# 脚本必须挂在可访问的 URL 上（如 GitHub Gist）。
# 启用方法：把 MEEFF_Ads_Filter.js 传到网上后，将下方
# script-path 的地址替换为你的真实地址，再去掉本行行首 #。
# 不想用脚本时，保持注释即可，前两层仍然生效。
# ============================================================
[Script]
# meeff-ads=type=http-response,pattern=^https?:\/\/api\.meeff\.com\/,requires-body=1,script-path=https://你的地址/MEEFF_Ads_Filter.js

[MITM]
hostname = %APPEND% api.meeff.com
